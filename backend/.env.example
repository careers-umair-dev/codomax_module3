# Server
PORT=5000
NODE_ENV=development

# Database — MongoDB Atlas connection string (Atlas → Connect → Drivers).
# Put the database name before the "?" and URL-encode special characters in the password.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/quill?retryWrites=true&w=majority

# Auth — use a long random string in real environments, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_super_secret_key
JWT_EXPIRES_IN=7d

# CORS — comma-separated list of frontend origins allowed to call this API
FRONTEND_URL=http://localhost:3000

# Optional tuning
# AUTH_RATE_LIMIT_MAX=50        # max login/register attempts per 15 min per IP
# MONGODB_TIMEOUT_MS=10000      # how long to wait for MongoDB before giving up
# DATA_DIR=./data               # legacy JSON files, only read by `npm run migrate`
# MONGODB_URI_TEST=...          # optional: a throw-away MongoDB for `npm test` (see README)
