  "description": "REST API for the Quill blog application (Module 3 — Node.js + Express + MongoDB/Mongoose)",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
